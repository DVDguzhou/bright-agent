page {
  background-color: #f4efe6;
  color: #111111;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
}

.card {
  background: #f4efe6;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.btn-primary {
  background: #111111;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary[disabled] {
  background: #999999;
  color: #ffffff;
}

.btn-secondary {
  background: transparent;
  color: #111111;
  border: 1rpx solid rgba(0, 0, 0, 0.15);
  border-radius: 999rpx;
  font-size: 28rpx;
}

.text-muted {
  color: #666666;
  font-size: 24rpx;
}

.text-error {
  color: #c0392b;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #888888;
}
