page {
  --paper: #f4efe6;
  --paper-50: #faf7f1;
  --paper-200: #ebe3d4;
  --ink: #1a1714;
  --ink-300: #8d8478;
  --ink-400: #6b6359;
  --ink-500: #4d463f;
  --ink-700: #2d2924;
  --hairline: #d8cfbf;
  --oxblood: #7a1f1f;
  --olive: #4a5a2f;
  background-color: var(--paper);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 48rpx;
}

.container-tab {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.font-serif {
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
}

.divide-y > view + view,
.divide-y > block + block {
  border-top: 1rpx solid var(--hairline);
}

.section-block {
  padding: 32rpx 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.section-body {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--ink-500);
}

.glass-card {
  background: var(--paper);
  border: 1rpx solid var(--hairline);
  border-radius: 4rpx;
}

.btn-primary {
  background: var(--ink);
  color: var(--paper);
  border-radius: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: var(--ink-300);
  color: var(--paper);
}

.btn-secondary {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--ink);
  border-radius: 4rpx;
  font-size: 28rpx;
}

.btn-secondary::after {
  border: none;
}

.input-shell {
  border: none;
  border-bottom: 1rpx solid var(--hairline);
  border-radius: 0;
  background: var(--paper);
  padding: 20rpx 8rpx;
  font-size: 30rpx;
}

.text-muted {
  color: var(--ink-300);
  font-size: 24rpx;
}

.text-error {
  color: var(--oxblood);
  font-size: 24rpx;
}

.text-italic {
  font-style: italic;
}

.empty {
  text-align: center;
  padding: 80rpx 32rpx;
  color: var(--ink-300);
  font-family: "Songti SC", "Noto Serif SC", serif;
}

.error-banner {
  margin: 24rpx 0;
  padding: 24rpx;
  background: rgba(122, 31, 31, 0.08);
  color: var(--oxblood);
  font-size: 26rpx;
  text-align: center;
}

.fixed-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(244, 239, 230, 0.95);
  border-top: 1rpx solid var(--hairline);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.tag-chip {
  display: inline-block;
  border: 1rpx solid var(--hairline);
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: var(--ink-500);
  margin: 0 12rpx 12rpx 0;
}

.verified-mark {
  color: var(--olive);
  font-size: 20rpx;
  letter-spacing: 0.1em;
}

.skeleton {
  background: var(--paper-200);
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
