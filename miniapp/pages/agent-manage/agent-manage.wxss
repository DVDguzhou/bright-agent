.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4efe6;
}

.manage-scroll {
  flex: 1;
  height: 100vh;
}

.manage-body {
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #8d8478;
  font-size: 28rpx;
}

.empty-state {
  padding: 120rpx 32rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  color: #1a1714;
  margin-bottom: 32rpx;
}

.empty-btn {
  margin-top: 16rpx;
}

.divider-top {
  border-top: 1rpx solid rgba(216, 207, 191, 0.35);
  margin-top: 8rpx;
  padding-top: 32rpx;
}

.back-row {
  padding-top: 8rpx;
  margin-bottom: 16rpx;
}

.back-link {
  font-size: 26rpx;
  font-weight: 500;
  color: #8d8478;
}

.hero-row {
  padding-bottom: 24rpx;
}

.hero-main {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.hero-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #ebe3d4;
}

.hero-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #7a1f1f;
}

.hero-meta {
  flex: 1;
  min-width: 0;
}

.hero-name {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #1a1714;
}

.hero-headline {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #ebe3d4;
  color: #1a1714;
}

.badge-live {
  background: rgba(107, 122, 74, 0.2);
  color: #4a5634;
}

.badge-muted {
  font-weight: 500;
  color: #8d8478;
}

.hero-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.icon-btn-eye {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-edit {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: #1a1714;
  color: #f4efe6;
  font-size: 26rpx;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1rpx solid rgba(216, 207, 191, 0.35);
}

.stat-cell {
  padding: 24rpx 16rpx;
  text-align: center;
  border-right: 1rpx solid rgba(216, 207, 191, 0.35);
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
}

.stat-cell:nth-child(2n) {
  border-right: none;
}

.stat-cell:nth-last-child(-n + 2) {
  border-bottom: none;
}

.stat-tap:active {
  opacity: 0.85;
}

.alert-link {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #7a1f1f;
  text-decoration: underline;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
  color: #1a1714;
}

.stat-label {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4d463f;
}

.stat-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
}

.mind-wrap {
  display: flex;
  justify-content: center;
  min-height: 52rpx;
  align-items: center;
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1714;
  letter-spacing: -0.02em;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.section-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.live-count {
  flex-shrink: 0;
  text-align: right;
  color: #8d8478;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.live-count-num {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1714;
  letter-spacing: 0;
  text-transform: none;
}

.live-count-label {
  display: block;
  margin-top: 4rpx;
}

.action-list {
  margin-top: 16rpx;
}

.action-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
}

.action-item:last-child {
  border-bottom: none;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon-oxblood {
  background: rgba(122, 31, 31, 0.12);
}

.action-icon-paper {
  background: #ebe3d4;
}

.action-icon-paper-light {
  background: rgba(244, 239, 230, 0.95);
  border: 1rpx solid rgba(216, 207, 191, 0.45);
}

.action-icon-olive {
  background: rgba(107, 122, 74, 0.18);
}

.action-copy {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1714;
}

.action-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.svg-icon {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

