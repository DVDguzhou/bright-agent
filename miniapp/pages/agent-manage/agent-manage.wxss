.live-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(216, 207, 191, 0.7);
  background: #f4efe6;
  font-size: 28rpx;
  line-height: 1.55;
  color: #1a1714;
}

.live-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.live-picker {
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(216, 207, 191, 0.7);
  background: #f4efe6;
  font-size: 24rpx;
  color: #4d463f;
}

.live-location {
  flex: 1;
  min-width: 200rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(216, 207, 191, 0.7);
  background: #f4efe6;
  font-size: 24rpx;
  color: #1a1714;
}

.live-post-btn {
  margin-left: auto;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  background: #1a1714;
  color: #f4efe6;
  font-size: 26rpx;
  font-weight: 600;
}

.live-post-btn.disabled {
  opacity: 0.4;
}

.live-list {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(216, 207, 191, 0.35);
}

.live-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
}

.live-item:last-child {
  border-bottom: none;
}

.live-item-main {
  flex: 1;
  min-width: 0;
}

.live-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #8d8478;
}

.live-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(122, 31, 31, 0.12);
  color: #7a1f1f;
  font-weight: 600;
}

.live-content {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1a1714;
}

.live-delete {
  padding: 8rpx;
}

.recent-block {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
}

.recent-block:last-child {
  border-bottom: none;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4d463f;
}

.recent-link {
  font-size: 24rpx;
  font-weight: 500;
  color: #7a1f1f;
}

.recent-empty {
  font-size: 26rpx;
  line-height: 1.5;
}

.recent-item {
  padding: 16rpx 0;
}

.recent-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1714;
}

.recent-detail {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.recent-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.alert-list {
  margin-top: 16rpx;
}

.alert-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
}

.alert-item:last-child {
  border-bottom: none;
}

.alert-dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: #7a1f1f;
  flex-shrink: 0;
}

.alert-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.alert-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #7a1f1f;
}

.alert-priority {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(122, 31, 31, 0.12);
  color: #7a1f1f;
  font-size: 20rpx;
  font-weight: 600;
}

.alert-dot.tone-red,
.alert-title.tone-red {
  color: #7a1f1f;
}

.alert-dot.tone-red {
  background: #7a1f1f;
}

.alert-priority.tone-red {
  background: rgba(122, 31, 31, 0.12);
  color: #7a1f1f;
}

.alert-dot.tone-orange,
.alert-title.tone-orange {
  color: #c2410c;
}

.alert-dot.tone-orange {
  background: #c2410c;
}

.alert-priority.tone-orange {
  background: rgba(194, 65, 12, 0.12);
  color: #c2410c;
}

.alert-dot.tone-yellow,
.alert-title.tone-yellow {
  color: #a16207;
}

.alert-dot.tone-yellow {
  background: #a16207;
}

.alert-priority.tone-yellow {
  background: rgba(161, 98, 7, 0.12);
  color: #a16207;
}

.alert-dot.tone-blue,
.alert-title.tone-blue {
  color: #1d4ed8;
}

.alert-dot.tone-blue {
  background: #1d4ed8;
}

.alert-priority.tone-blue {
  background: rgba(29, 78, 216, 0.12);
  color: #1d4ed8;
}

.alert-dot.tone-default {
  background: #7a1f1f;
}

.alert-title.tone-default {
  color: #7a1f1f;
}

.alert-priority.tone-default {
  background: rgba(122, 31, 31, 0.12);
  color: #7a1f1f;
}

.alert-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.suggest-list {
  margin-top: 16rpx;
}

.suggest-item {
  display: block;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
  font-size: 28rpx;
  line-height: 1.6;
  color: #1a1714;
}

.suggest-item:last-child {
  border-bottom: none;
}

.status-grid {
  margin-top: 16rpx;
}

.status-cell {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
}

.status-cell:last-child {
  border-bottom: none;
}

.status-label {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
}

.status-value {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #1a1714;
}

.danger-section {
  padding-bottom: 16rpx;
}

.danger-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.danger-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #7a1f1f;
}

.danger-hint {
  font-size: 22rpx;
  color: #7a1f1f;
  opacity: 0.75;
}

.danger-chevron {
  margin-left: auto;
  color: #7a1f1f;
  font-size: 28rpx;
}

.danger-body {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(122, 31, 31, 0.2);
}

.danger-copy {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
}

.danger-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 96rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(122, 31, 31, 0.25);
  background: #f4efe6;
  color: #7a1f1f;
  font-size: 28rpx;
  font-weight: 500;
}

.danger-btn[disabled] {
  opacity: 0.5;
}
