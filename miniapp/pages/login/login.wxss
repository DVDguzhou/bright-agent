.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.tabs {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.tab {
  padding: 8rpx 0;
  color: #888;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #111;
  font-weight: 600;
  border-bottom-color: #111;
}

.input {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.flex {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.login-btn {
  margin-top: 16rpx;
}
