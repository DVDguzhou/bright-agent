.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4efe6;
}

.login-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.login-wrap {
  padding: 48rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.login-title {
  display: block;
  font-size: 60rpx;
  font-weight: 600;
  color: #1a1714;
  line-height: 1.2;
}

.login-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
}

.form-card {
  margin-top: 40rpx;
  padding: 48rpx 40rpx;
  background: #f4efe6;
  border: 1rpx solid #d8cfbf;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 23, 20, 0.04);
}

.form-hint {
  display: block;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4d463f;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #4d463f;
}

.form-card .input-shell {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 0;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 1.5;
  padding: 20rpx 8rpx;
  font-size: 30rpx;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.flex-input {
  flex: 1;
  min-width: 0;
}

.code-send-btn {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ebe3d4;
  color: #4d463f;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}

.code-send-btn.disabled {
  opacity: 0.5;
}

.text-error {
  display: block;
  margin-bottom: 20rpx;
}

.login-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
}

.mode-switch {
  margin-top: 32rpx;
  text-align: center;
}

.mode-switch-text {
  font-size: 26rpx;
  color: #7a1f1f;
}

.signup-hint {
  margin-top: 48rpx;
  text-align: center;
  font-size: 26rpx;
}

.signup-link {
  color: #7a1f1f;
  font-weight: 600;
}

.footer-links {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.link {
  font-size: 24rpx;
  color: #7a1f1f;
}
