@import "../../styles/agent-manage-subpage.wxss";

.edit-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.edit-save-top {
  flex-shrink: 0;
  margin-top: 40rpx;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
}

.edit-section {
  padding-bottom: 16rpx;
}

.edit-fields {
  margin-top: 24rpx;
}

.voice-note {
  display: block;
  font-size: 26rpx;
  color: #6b6458;
  margin-bottom: 12rpx;
}

.voice-btn {
  display: inline-block;
  margin-bottom: 16rpx;
}

.publish-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0;
  font-size: 28rpx;
  color: #4d463f;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.region-chip {
  background: #ebe3d4;
  color: #6b6458;
}

.chip-on.region-chip {
  background: #1a1714;
  color: #f4efe6;
}

.chip-disabled {
  opacity: 0.4;
}

.picker-val {
  line-height: 1.4;
}

.save-error {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7a1f1f;
}

.save-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b5aea3;
  line-height: 1.5;
}

.cover-hint {
  display: block;
  font-size: 24rpx;
  color: #8d8478;
  margin-bottom: 16rpx;
}

.cover-preview-wrap {
  width: 280rpx;
  aspect-ratio: 4 / 5;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(216, 207, 191, 0.6);
  background: #ebe3d4;
  margin-bottom: 16rpx;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.voice-block {
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(216, 207, 191, 0.35);
  margin-bottom: 24rpx;
}

.voice-pending {
  display: block;
  margin: 8rpx 0 12rpx;
  font-size: 26rpx;
  color: #4a5634;
  line-height: 1.5;
}

.voice-id {
  display: block;
  margin: 8rpx 0 12rpx;
  font-size: 22rpx;
  color: #8d8478;
  word-break: break-all;
  font-family: monospace;
}

.voice-actions,
.voice-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}

.voice-panel-hint {
  width: 100%;
  font-size: 24rpx;
  color: #8d8478;
}

.voice-record-btn {
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  background: #1a1714;
  color: #f4efe6;
  font-size: 28rpx;
  font-weight: 600;
}

.voice-record-btn.recording {
  background: #7a1f1f;
}

.verification-block {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(216, 207, 191, 0.35);
}

.verification-ok {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #4a5634;
}

.verification-pending {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b6458;
  line-height: 1.5;
}
