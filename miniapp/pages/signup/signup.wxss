.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4efe6;
}

.signup-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.signup-wrap {
  padding: 48rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.signup-title {
  display: block;
  font-size: 60rpx;
  font-weight: 600;
  color: #7a1f1f;
  line-height: 1.2;
}

.signup-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
}

.form-card {
  margin-top: 40rpx;
  padding: 48rpx 40rpx;
  background: #f4efe6;
  border: 1rpx solid #d8cfbf;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 23, 20, 0.04);
}

.avatar-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 40rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid #d8cfbf;
  background: rgba(235, 227, 212, 0.35);
  box-sizing: border-box;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 48rpx;
  border: 1rpx solid rgba(244, 239, 230, 0.8);
  flex-shrink: 0;
  background: #ebe3d4;
}

.avatar-meta {
  flex: 1;
  min-width: 0;
}

.avatar-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #4d463f;
}

.avatar-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.avatar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.avatar-upload-btn {
  border: 1rpx solid #1a1714;
  background: transparent;
  color: #1a1714;
}

.avatar-btn {
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.avatar-btn.disabled {
  opacity: 0.5;
}

.btn-ghost {
  border: 1rpx solid #d8cfbf;
  background: #f4efe6;
  color: #4d463f;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #4d463f;
}

.form-card .input-shell {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 0;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 1.5;
  padding: 20rpx 8rpx;
  font-size: 30rpx;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.flex-input {
  flex: 1;
  min-width: 0;
}

.code-send-btn {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ebe3d4;
  color: #4d463f;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}

.code-send-btn.disabled {
  opacity: 0.5;
}

.field-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.code-input {
  letter-spacing: 0.3em;
}

.terms-row {
  margin-bottom: 24rpx;
}

.terms-label {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 26rpx;
  color: #4d463f;
  line-height: 1.6;
}

.terms-text {
  margin-left: 4rpx;
}

.terms-link {
  color: #7a1f1f;
  text-decoration: underline;
}

.text-error {
  display: block;
  margin-bottom: 20rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
}

.login-hint {
  margin-top: 48rpx;
  text-align: center;
  font-size: 26rpx;
}

.login-link {
  color: #7a1f1f;
  font-weight: 600;
}

.footer-links {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.link {
  font-size: 24rpx;
  color: #7a1f1f;
}
