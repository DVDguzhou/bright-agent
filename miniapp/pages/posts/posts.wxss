.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f4efe6;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.body {
  padding: 24rpx 32rpx 0;
}

.feed-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.create-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 28rpx;
  border-radius: 4rpx;
  background: #1a1714;
  color: #f4efe6;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  letter-spacing: 0.02em;
}

.create-plus {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 500;
}

.tab-switch {
  display: inline-flex;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(235, 227, 212, 0.7);
  border: 1rpx solid rgba(216, 207, 191, 0.5);
  flex-shrink: 0;
}

.tab-pill {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8d8478;
}

.tab-pill-active {
  background: #f4efe6;
  color: #1a1714;
  box-shadow: 0 4rpx 12rpx rgba(26, 23, 20, 0.06);
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(122, 31, 31, 0.08);
  color: #7a1f1f;
  font-size: 28rpx;
}

.error-retry {
  margin-left: 16rpx;
  font-weight: 600;
  text-decoration: underline;
}

.feed-list {
  border-top: 1rpx solid rgba(216, 207, 191, 0.35);
}

.post-card {
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.35);
}

.post-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.post-author {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.avatar-hit,
.comment-avatar-hit {
  flex-shrink: 0;
}

.avatar-hit .avatar,
.comment-avatar-hit .comment-avatar {
  display: block;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #ebe3d4;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #7a1f1f;
  color: #f4efe6;
  font-size: 28rpx;
  font-weight: 600;
}

.head-meta {
  min-width: 0;
  flex: 1;
}

.author-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1714;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.private-badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ebe3d4;
  font-size: 20rpx;
  color: #6b6359;
}

.time-label {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
}

.owner-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.action-link {
  font-size: 24rpx;
  color: #8d8478;
}

.action-link.danger {
  color: #7a1f1f;
}

.post-content {
  display: block;
  font-size: 30rpx;
  line-height: 1.65;
  color: #1a1714;
  white-space: pre-wrap;
}

.image-grid {
  display: grid;
  gap: 12rpx;
  margin-top: 16rpx;
}

.grid-1 {
  grid-template-columns: 1fr;
}

.grid-2 {
  grid-template-columns: 1fr 1fr;
}

.grid-3 {
  grid-template-columns: 1fr 1fr 1fr;
}

.post-image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  background: #ebe3d4;
}

.post-actions {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-top: 24rpx;
  padding-top: 8rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #8d8478;
}

.action-btn-liked {
  color: #7a1f1f;
}

.icon-heart,
.icon-comment {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

