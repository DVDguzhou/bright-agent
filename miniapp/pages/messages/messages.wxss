.page {
  min-height: 100vh;
  padding: 0 32rpx calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4efe6;
}

.header {
  padding: 8rpx 0 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: #1a1714;
}

.search-wrap {
  padding-bottom: 24rpx;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 1.5;
  padding: 20rpx 8rpx;
  border: none;
  border-bottom: 1rpx solid #d8cfbf;
  border-radius: 0;
  background: #f4efe6;
  font-size: 30rpx;
  color: #1a1714;
}

.list {
  border-top: 1rpx solid #d8cfbf;
}

.session-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #d8cfbf;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(26, 23, 20, 0.1);
  background: #ebe3d4;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1714;
  color: #f4efe6;
  font-size: 36rpx;
}

.session-main {
  flex: 1;
  min-width: 0;
}

.session-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.session-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1714;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  flex-shrink: 0;
  padding-top: 4rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.session-preview {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.center-state {
  display: flex;
  min-height: 50vh;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
}

.center-text {
  font-size: 28rpx;
}

.empty-state {
  padding: 128rpx 32rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-style: italic;
  color: #8d8478;
}

.empty-btn {
  margin-top: 40rpx;
  display: inline-flex;
  padding: 24rpx 48rpx;
  border-radius: 4rpx;
}

.empty-search {
  padding: 128rpx 32rpx;
}

.empty-search-text {
  display: block;
  font-size: 30rpx;
}

.clear-link {
  display: block;
  margin-top: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6b6359;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.skeleton-row .session-main {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sk-name {
  width: 256rpx;
  height: 32rpx;
  border-radius: 4rpx;
}

.sk-preview {
  width: 384rpx;
  max-width: 100%;
  height: 24rpx;
  border-radius: 4rpx;
}

.sk-time {
  width: 80rpx;
  height: 24rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.skeleton-row .avatar {
  border: none;
}
