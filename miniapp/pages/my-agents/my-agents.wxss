.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4efe6;
}

.search-wrap {
  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 1.5;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: #ebe3d4;
  font-size: 30rpx;
  color: #1a1714;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 56rpx;
}

.grid-col {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #8d8478;
  font-size: 28rpx;
}

.empty-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.empty-state {
  margin-top: 48rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  border: 1rpx dashed #d8cfbf;
  border-radius: 32rpx;
  background: #f4efe6;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1714;
}

.empty-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 40rpx;
  width: 100%;
  max-width: 400rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
}

.empty-btn-secondary {
  margin-top: 20rpx;
  width: 100%;
  max-width: 400rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
}
