.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f4efe6;
}

.remain-bar {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.messages {
  flex: 1;
  padding: 16rpx 32rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  line-height: 1.5;
  word-break: break-word;
}

.msg-row.user .bubble {
  background: #111;
  color: #fff;
  border: none;
}

.bubble.error {
  color: #c0392b;
}

.composer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f4efe6;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.composer-input {
  flex: 1;
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.send-btn {
  align-self: center;
  min-width: 120rpx;
}
