.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.section-head {
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.purchased {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.purchased-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #eee7db;
}

.name {
  display: block;
  font-weight: 600;
}

.mini {
  flex-shrink: 0;
}

.links {
  padding: 0;
  overflow: hidden;
}

.link-row {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.link-row:last-child {
  border-bottom: none;
}

.danger {
  color: #c0392b;
}
