.page {
  min-height: 100vh;
  background: #f4efe6;
  box-sizing: border-box;
}

.scroll {
  height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(216, 207, 191, 0.8);
}

.brand {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.title {
  display: block;
  margin-top: 16rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #1a1714;
  letter-spacing: -0.02em;
}

.meta {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
}

.intro {
  display: block;
  margin-top: 32rpx;
  font-size: 30rpx;
  line-height: 1.65;
  color: #4d463f;
}

.section {
  margin-bottom: 64rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1714;
  margin-bottom: 24rpx;
}

.para {
  display: block;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  line-height: 1.65;
  color: #4d463f;
}

.para:last-child {
  margin-bottom: 0;
}

.footer-card {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(216, 207, 191, 0.6);
  background: rgba(244, 239, 230, 0.95);
  box-sizing: border-box;
}

.footer-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.footer-label {
  font-size: 28rpx;
}

.footer-link {
  font-size: 28rpx;
  color: #7a1f1f;
  text-decoration: underline;
  word-break: break-all;
}

.back-link {
  display: block;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #7a1f1f;
}
