.hero {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  background: #eee7db;
}

.name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.headline {
  display: block;
  margin-top: 8rpx;
  color: #444;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
}

.bio {
  display: block;
  margin-top: 12rpx;
  color: #333;
  line-height: 1.6;
}

.facts {
  margin-top: 16rpx;
  color: #666;
  font-size: 26rpx;
}

.facts text {
  display: block;
  margin-top: 4rpx;
}

.price {
  display: block;
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.remain {
  display: block;
  margin-top: 8rpx;
}

.section-title {
  display: block;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.sample {
  display: block;
  color: #444;
  margin-top: 8rpx;
}

.chat-btn {
  margin-top: 8rpx;
}
