<view class="page">
  <feed-top-nav
    leftMode="back"
    bind:back="goBack"
    bind:posts="goPosts"
    bind:discover="goDiscover"
    bind:search="goSearch"
  ></feed-top-nav>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="hero-skeleton skeleton"></view>
    <view class="line-skeleton skeleton"></view>
    <view class="line-skeleton short skeleton"></view>
  </view>

  <view wx:elif="{{error}}" class="empty-state font-serif">
    <text class="empty-title">{{error}}</text>
    <text class="empty-sub">链接可能已失效，请从列表重新进入。</text>
    <button class="btn-primary empty-btn" bindtap="goBack">返回列表</button>
  </view>

  <block wx:else>
    <view class="hero-wrap">
      <view class="hero-box">
        <image
          wx:if="{{coverFull}}"
          class="hero"
          src="{{coverFull}}"
          mode="aspectFill"
          binderror="onCoverError"
        ></image>
        <view class="hero-overlay"></view>
        <view class="hero-actions">
          <view class="star-btn" bindtap="toggleStar">
            <view class="icon-star {{starred ? 'filled' : ''}}"></view>
          </view>
          <view wx:if="{{showHeroVerify}}" class="verify-wrap">
            <verification-badge status="{{verificationStatus}}" size="sm"></verification-badge>
          </view>
        </view>
      </view>
    </view>

    <view class="content">
      <view class="section">
        <text class="display-name font-serif">{{displayName}}</text>
        <view class="claim-row">
          <text class="claim-badge {{isClaimed ? 'claimed' : 'unclaimed'}}">{{claimLabel}}</text>
        </view>
        <text class="headline font-serif">{{intro.headline}}</text>
        <view wx:if="{{tags.length}}" class="tags">
          <text wx:for="{{tags}}" wx:key="*this" class="tag-chip">{{item}}</text>
        </view>
        <view class="stats-row">
          <text class="text-muted">{{sessionCount}} 场聊天</text>
          <mind-score-badge wx:if="{{hasMindScore}}" value="{{mindScore}}" size="sm"></mind-score-badge>
        </view>
      </view>

      <view class="section">
        <view class="creator-row">
          <view class="creator-avatar font-serif">{{creatorInitial}}</view>
          <view class="creator-info">
            <view class="creator-name-row">
              <text class="creator-name">{{creatorName}}</text>
              <verification-badge status="{{verificationStatus}}" size="sm"></verification-badge>
            </view>
            <text class="creator-bio text-muted">{{intro.shortBio}}</text>
          </view>
        </view>
        <view wx:if="{{facts.length}}" class="facts-grid">
          <text wx:for="{{facts}}" wx:key="label" class="fact-item">
            <text class="fact-label">{{item.label}}</text>　{{item.value}}
          </text>
        </view>
      </view>

      <view class="section">
        <text class="section-title">适合咨询的人群</text>
        <text class="section-body" user-select>{{intro.audience}}</text>
      </view>

      <view wx:if="{{liveUpdates.length}}" class="section">
        <text class="section-title">最近动态</text>
        <view class="updates">
          <view wx:for="{{liveUpdates}}" wx:key="id" class="update-item">
            <view class="update-meta">
              <text class="update-cat">{{item.categoryLabel}}</text>
              <text wx:if="{{item.location}}" class="text-muted">{{item.location}}</text>
              <text class="text-muted">{{item.freshLabel}}</text>
            </view>
            <text class="update-content">{{item.content}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{sampleQuestions.length}}" class="section">
        <text class="section-title">你可以问这些问题</text>
        <view class="sample-list">
          <view wx:for="{{sampleQuestions}}" wx:key="*this" class="sample-item">
            <text class="sample-num">{{index + 1}}.</text>
            <text class="sample-text">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">开场欢迎语</text>
        <text class="welcome font-serif" user-select>{{intro.welcomeMessage}}</text>
      </view>

      <view class="section">
        <text class="section-title">用户评价</text>
        <view class="rating-head">
          <text class="rating-score font-serif">{{ratingDisplay}}</text>
          <view>
            <rating-stars score="{{averageScore}}" size="md"></rating-stars>
            <text class="text-muted rating-sub">{{ratingSubtext}}</text>
          </view>
        </view>
        <view wx:if="{{recentReviews.length}}" class="reviews">
          <view wx:for="{{recentReviews}}" wx:key="id" class="review-item">
            <view class="review-head">
              <rating-stars score="{{item.score}}" size="sm"></rating-stars>
              <text class="review-date text-muted">{{item.dateLabel}}</text>
            </view>
            <text wx:if="{{item.comment}}" class="review-comment">{{item.comment}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>

    <view class="fixed-bottom-bar">
      <text wx:if="{{priceHint}}" class="price-hint text-muted">{{priceHint}}</text>
      <button wx:if="{{!isLoggedIn}}" class="btn-primary cta-btn" bindtap="goLogin">登录后开始咨询</button>
      <button wx:elif="{{remainingQ > 0}}" class="btn-primary cta-btn" bindtap="goChat">继续聊天（剩余 {{remainingQ}} 次）</button>
      <button wx:else class="btn-primary cta-btn" bindtap="goChat">开始咨询</button>
    </view>
  </block>
</view>
