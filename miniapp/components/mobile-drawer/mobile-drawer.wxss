.auth-actions {
  margin-top: 16rpx;
  padding: 16rpx 24rpx 0;
  border-top: 1rpx solid #d8cfbf;
}

.auth-btn {
  width: 100%;
  padding: 24rpx 0;
}

.auth-hint {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.5;
}
