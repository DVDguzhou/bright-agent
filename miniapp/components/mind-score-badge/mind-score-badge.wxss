.badge {
  display: inline-flex;
  align-items: center;
  background: #ebe3d4;
  color: #2d2924;
  font-weight: 500;
  border: 1rpx solid rgba(216, 207, 191, 0.7);
}

.badge-xs {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.badge-sm {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
}

.badge-md {
  padding: 8rpx 20rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
}
