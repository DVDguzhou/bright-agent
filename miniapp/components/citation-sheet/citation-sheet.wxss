.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(17, 21, 19, 0.35);
}

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  background: #faf9f6;
  border-top: 1px solid rgba(17, 21, 19, 0.08);
  border-radius: 12px 12px 0 0;
  display: flex;
  flex-direction: column;
}

.sheet-handle {
  width: 40px;
  height: 4px;
  margin: 10px auto 0;
  border-radius: 999px;
  background: rgba(17, 21, 19, 0.12);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid rgba(17, 21, 19, 0.08);
}

.sheet-title {
  font-size: 14px;
  font-weight: 600;
  color: #111513;
}

.sheet-close {
  font-size: 22px;
  line-height: 1;
  color: rgba(17, 21, 19, 0.45);
  padding: 4px 8px;
}

.sheet-body {
  flex: 1;
  max-height: calc(78vh - 56px);
  padding: 12px 16px 24px;
  box-sizing: border-box;
}

.sheet-section + .sheet-section {
  margin-top: 16px;
}

.sheet-label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: rgba(17, 21, 19, 0.45);
  margin-bottom: 8px;
}

.source-card {
  border: 1px solid rgba(17, 21, 19, 0.1);
  border-radius: 6px;
  background: #fff;
  padding: 10px 12px;
}

.source-card + .source-card {
  margin-top: 8px;
}

.source-card.active {
  border-color: rgba(45, 106, 79, 0.35);
  background: rgba(45, 106, 79, 0.06);
}

.source-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}

.cite-badge {
  font-size: 11px;
  color: rgba(17, 21, 19, 0.45);
  font-weight: 600;
}

.type-badge {
  font-size: 10px;
  padding: 2px 6px;
  border: 1px solid rgba(17, 21, 19, 0.1);
  border-radius: 4px;
  color: rgba(17, 21, 19, 0.55);
}

.source-title {
  display: block;
  margin-top: 6px;
  font-size: 14px;
  font-weight: 600;
  color: #111513;
}

.source-excerpt {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.5;
  color: rgba(17, 21, 19, 0.55);
  white-space: pre-wrap;
}
