# ========== 生产环境配置模板 ==========
# 复制为 .env 后按实际密钥修改，再执行 docker compose up -d --build

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=54254

# ---------- 站点公网地址（必填）----------
# 当前站点域名 brightagent.cn（HTTPS 部署后使用 https://）
# 也可用 IP（如 http://8.136.119.234:3000）；麦克风录音需 HTTPS 或 localhost
NEXTAUTH_URL=https://brightagent.cn

# 后端用于生成音频等资源的公网地址，通常与 NEXTAUTH_URL 一致
BASE_URL=https://brightagent.cn

# 微信回调后重定向地址，不填则用 NEXTAUTH_URL
FRONTEND_URL=https://brightagent.cn

# ---------- CORS（必填）----------
# 允许的前端来源，逗号分隔（根域名与 www 都写上）
CORS_ORIGINS=https://brightagent.cn,https://www.brightagent.cn

# ---------- 会话与安全（必填）----------
# 生产环境务必改为随机字符串，至少 32 位
SESSION_SECRET=请替换为随机字符串至少32位
# HTTPS 站点必填 true，否则登录 Cookie 可能无法写入，表现为「注册/登录一直失败」
SECURE_SESSION_COOKIE=true

# ---------- AI 聊天 ----------
# 方案 A：通义千问（国内服务器直连，默认推荐）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
# OPENAI_API_KEY=sk-你的通义Key

# 方案 B：Google Gemini（国内服务器需配 LLM_HTTP_PROXY，见下方）
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.1-pro-preview
OPENAI_API_KEY=你的Google_AI_Studio_Key

# 国内 ECS 访问 Google 需走宿主机代理（Clash / V2Ray 等）。
# Docker 容器内用 host.docker.internal 指向宿主机（compose 已配 extra_hosts）。
# 例：宿主机 Clash 监听 7890
LLM_HTTP_PROXY=http://host.docker.internal:7890

LLM_ENABLE_WEB_SEARCH=你的信息查询服务ID

# ---------- 语音条 / 声音复刻 ----------
TTS_PROVIDER=dashscope
DASHSCOPE_VC_MODEL=qwen3-tts-vc-2026-01-22
DASHSCOPE_VOICE_ENROLL_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization

# ---------- 微信登录（可选）----------
# 微信开放平台「授权回调域」填 brightagent.cn（不含协议与路径）
WECHAT_APP_ID=wx你的AppID
WECHAT_APP_SECRET=你的AppSecret
WECHAT_REDIRECT_URI=https://brightagent.cn/api/auth/wechat/callback

# ---------- 微信支付 Native 扫码（可选，人生 Agent 购买）----------
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_MCH_CERT_SERIAL=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_apiclient_key.pem
# 与商户号绑定的 AppID；不填则复用 WECHAT_APP_ID
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_NOTIFY_URL=https://brightagent.cn/api/pay/wechat/notify

# ---------- 手机号登录（可选）----------
SMS_ACCESS_KEY_ID=阿里云AccessKeyId
SMS_ACCESS_KEY_SECRET=阿里云AccessKeySecret
SMS_SIGN_NAME=已审核的短信签名
SMS_TEMPLATE_CODE=SMS_xxx

# ---------- 发信 / 官方客服邮箱（邮箱验证码、找回密码、联系客服页）----------
# SMTP_USER / SMTP_FROM 建议与前端 official-contact 一致：brightagent2026@163.com
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=brightagent2026@163.com
# SMTP_PASSWORD=163授权码
# SMTP_FROM=brightagent2026@163.com

# ---------- 登录页 Tab（可选，默认仅邮箱）----------
# NEXT_PUBLIC_LOGIN_SHOW_WECHAT=true
# NEXT_PUBLIC_LOGIN_SHOW_PHONE=true

# ---------- 平台客服 Agent（可选）----------
# 配置后 /support/chat 直接进入该 Agent 对话，否则展示邮件联系页
# NEXT_PUBLIC_PLATFORM_SUPPORT_AGENT_ID=

# ---------- 其他 ----------
PLATFORM_SIGNING_SECRET=生产环境随机字符串
ORCHESTRATOR_BUYER_API_KEY=sk_live_xxx
